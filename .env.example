# Backend Settings
SECRET_KEY=super_secret_jwt_key_change_me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
ENCRYPTION_KEY=fernet_symmetric_key_change_me

# Database
# For local Dev we can use sqlite, but docker compose uses postgres
DATABASE_URL=postgresql://admin:password@postgres:5432/qa_hub

# Jenkins
JENKINS_URL=http://jenkins:8080
JENKINS_USER=admin
JENKINS_API_TOKEN=your_jenkins_api_token
