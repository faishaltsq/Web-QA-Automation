<?xml version='1.1' encoding='UTF-8'?>
<project>
  <description>Run Playwright automation script in Docker container</description>
  <keepDependencies>false</keepDependencies>
  <properties>
    <hudson.model.ParametersDefinitionProperty>
      <parameterDefinitions>
        <hudson.model.StringParameterDefinition>
          <name>SCRIPT_PATH</name>
          <defaultValue></defaultValue>
          <description>Relative path to spec file in /data/automation/tests/</description>
        </hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>BROWSER</name>
          <defaultValue>chromium</defaultValue>
          <description>Browser to use</description>
        </hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>BASE_URL</name>
          <defaultValue>http://nextjs:3000</defaultValue>
          <description>Base URL for tests</description>
        </hudson.model.StringParameterDefinition>
      </parameterDefinitions>
    </hudson.model.ParametersDefinitionProperty>
  </properties>
  <scm class="hudson.scm.NullSCM"/>
  <builders>
    <hudson.tasks.Shell>
      <command>docker run --rm --network webqa_qa-hub-network -v webqa_automation_scripts:/data/automation -v webqa_reports_data:/data/reports -e SCRIPT_PATH=&quot;${SCRIPT_PATH}&quot; -e BROWSER=&quot;${BROWSER}&quot; -e BASE_URL=&quot;${BASE_URL}&quot; playwright-runner:latest</command>
    </hudson.tasks.Shell>
  </builders>
  <publishers>
    <hudson.tasks.ArtifactArchiver>
      <artifacts>**/test-results/**,**/*.json</artifacts>
      <allowEmptyArchive>true</allowEmptyArchive>
    </hudson.tasks.ArtifactArchiver>
  </publishers>
</project>